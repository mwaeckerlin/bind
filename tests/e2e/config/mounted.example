$TTL    3600
@       IN      SOA     mounted.example. root.mounted.example. (
                        1       ; Serial
                        3600    ; Refresh
                        1800    ; Retry
                        604800  ; Expire
                        1800 )  ; Negative Cache TTL
;
@       IN      NS      @
@       IN      A       10.99.0.1
@       IN      MX 10   mail.mounted.example.
www     IN      CNAME   @
